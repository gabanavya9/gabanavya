//Q66: Insert an element in a sorted array at the appropriate position.

#include <stdio.h>

int main() {
    int n, i, key;
    int arr[100];

    scanf("%d", &n);

    // Read sorted array
    for (i = 0; i < n; i++) {
        scanf("%d", &arr[i]);
    }

    // Read element to insert
    scanf("%d", &key);

    // Shift larger elements to the right
    i = n - 1;

    while (i >= 0 && arr[i] > key) {
        arr[i + 1] = arr[i];
        i--;
    }

    // Insert element at correct position
    arr[i + 1] = key;
    n++;

    // Print updated array
    for (i = 0; i < n; i++) {
        printf("%d ", arr[i]);
    }

    return 0;
}
