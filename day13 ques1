//Q25: Write a program to implement a basic calculator using switch-case for +, -, *, /, %.

#include <stdio.h>

int main() {
    int num1, num2;
    char op;

    // Input two numbers and an operator
    scanf("%d %d %c", &num1, &num2, &op);

    switch (op) {
        case '+':
            printf("%d", num1 + num2);
            break;

        case '-':
            printf("%d", num1 - num2);
            break;

        case '*':
            printf("%d", num1 * num2);
            break;

        case '/':
            if (num2 != 0)
                printf("%d", num1 / num2);
            else
                printf("Division by zero is not allowed");
            break;

        case '%':
            if (num2 != 0)
                printf("%d", num1 % num2);
            else
                printf("Modulo by zero is not allowed");
            break;

        default:
            printf("Invalid operator");
    }

    return 0;
}
